{
  "name": "prismotive",
  "version": "0.1.0",
  "description": "A lightweight, framework-independent TypeScript library for animated borders, flowing waves, and interactive cursor trails with customisable colour themes.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "devigitlearn",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build:types": "tsc --project tsconfig.build.json",
    "build:js": "vite build",
    "build": "npm run typecheck && npm run build:js && npm run build:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:browser",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" \"eslint.config.mjs\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.config.ts\" \"eslint.config.mjs\" \"package.json\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devigitlearn/prismotive.git"
  },
  "bugs": {
    "url": "https://github.com/devigitlearn/prismotive/issues"
  },
  "homepage": "https://github.com/devigitlearn/prismotive#readme",
  "keywords": [
    "animation",
    "animated-border",
    "wave-animation",
    "cursor-trail",
    "visual-effects",
    "typescript",
    "color-themes",
    "framework-agnostic"
  ],
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
